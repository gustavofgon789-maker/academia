generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["garagem"]
}

model AdminUser {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  role          String   @default("admin") @db.VarChar(50)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("admin_users")
  @@schema("garagem")
}

model Vehicle {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique @db.VarChar(500)
  title             String   @db.VarChar(500)
  brand             String   @db.VarChar(100)
  model             String   @db.VarChar(100)
  version           String   @db.VarChar(200)
  year_fabrication  Int
  year_model        Int
  price             Decimal  @db.Decimal(12, 2)
  promotional_price Decimal? @db.Decimal(12, 2)
  mileage           Int
  transmission      String   @db.VarChar(50)
  fuel              String   @db.VarChar(50)
  color             String   @db.VarChar(50)
  body_type         String   @db.VarChar(50)
  doors             Int      @default(4)
  plate_final       String   @db.VarChar(1)
  status            String   @default("available") @db.VarChar(50)
  is_featured       Boolean  @default(false)
  is_promotion      Boolean  @default(false)
  is_active         Boolean  @default(true)
  description       String?  @db.Text
  options           Json?    @default("[]")
  internal_notes    String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  images VehicleImage[]
  leads  Lead[]

  @@map("vehicles")
  @@schema("garagem")
}

model VehicleImage {
  id         String   @id @default(uuid()) @db.Uuid
  vehicle_id String   @db.Uuid
  image_url  String   @db.Text
  is_main    Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@map("vehicle_images")
  @@schema("garagem")
}

model Lead {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  phone      String   @db.VarChar(50)
  email      String?  @db.VarChar(255)
  vehicle_id String?  @db.Uuid
  message    String?  @db.Text
  source     String   @default("website") @db.VarChar(50)
  status     String   @default("new") @db.VarChar(50)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vehicle Vehicle? @relation(fields: [vehicle_id], references: [id], onDelete: SetNull)

  @@map("leads")
  @@schema("garagem")
}

model SiteSettings {
  id             String   @id @default(uuid()) @db.Uuid
  business_name  String   @db.VarChar(255)
  logo_url       String?  @db.Text
  whatsapp       String   @db.VarChar(50)
  phone          String   @db.VarChar(50)
  address        String?  @db.Text
  opening_hours  String?  @db.Text
  hero_title     String   @db.VarChar(500)
  hero_subtitle  String?  @db.Text
  hero_image_url String?  @db.Text
  instagram_url  String?  @db.Text
  facebook_url   String?  @db.Text
  primary_color  String   @default("#dc2626") @db.VarChar(20)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("site_settings")
  @@schema("garagem")
}
